# Neon PostgreSQL connection string. Keep this in local .env or Streamlit Cloud secrets.
DATABASE_URL=

# AI provider keys are used by later phases.
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_PROVIDER=gemini
GEMINI_MODEL=gemini-2.5-flash
OPENAI_MODEL=gpt-4.1-mini

# AI budget guard (in-memory, per process). Blank uses safe defaults.
AI_MAX_CALLS_PER_DAY=
AI_MAX_TOKENS_PER_DAY=
AI_CACHE_TTL_SECONDS=
